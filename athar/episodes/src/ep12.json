   "clip": 903,
   "voice": "",
   "gap": 1.6,
   "lines": [
    {
     "cls": "mid",
     "html": "نزلَ البئرَ مرّةً أخرى"
    },
    {
     "f": 0.4,
     "cls": "mid gold",
     "html": "ملأ خُفَّه ماءً… وسقى الكلب"
    }
   ],
   "subs": [
    {
     "text": "So he went down again, filled his shoe with water, and gave the dog a drink."
    }
